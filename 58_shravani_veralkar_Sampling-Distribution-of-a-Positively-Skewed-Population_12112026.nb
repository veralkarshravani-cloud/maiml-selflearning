Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "sr", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pop", "=", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"SkewNormalDistribution", "[", 
           RowBox[{"0", ",", "1", ",", "8"}], "]"}], ",", "10000"}], "]"}]}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"GraphicsColumn", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Histogram", "[", 
           RowBox[{
            RowBox[{"{", "pop", "}"}], ",", 
            RowBox[{"PlotLabel", "\[Rule]", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<The Population (\>\"", ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<N\>\"", ",", "Italic"}], "]"}], " ", ",", 
                "\"\< = 10,000)\>\""}], "}"}], "]"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Histogram", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Mean", "[", 
               RowBox[{"RandomChoice", "[", 
                RowBox[{"pop", ",", "n"}], "]"}], "]"}], ",", 
              RowBox[{"{", "r", "}"}]}], "]"}], ",", " ", 
            RowBox[{
            "PlotLabel", "\[Rule]", " ", 
             "\"\<The Sampling Distribution of the Mean\>\""}]}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ImageSize", "\[Rule]", " ", 
         RowBox[{"{", 
          RowBox[{"390", ",", "450"}], "}"}]}]}], "\[IndentingNewLine]", 
       "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
   "\"\<generate a new population\>\"", ",", "\[IndentingNewLine]", 
   RowBox[{"Button", "[", 
    RowBox[{"\"\<population\>\"", ",", " ", 
     RowBox[{"sr", "=", 
      RowBox[{"RandomInteger", "[", "10000", "]"}]}], ",", 
     RowBox[{"ImageSize", "\[Rule]", " ", "125"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "Delimiter", ",", "\[IndentingNewLine]", 
   "\"\<sample size (n)\>\"", ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "10", ",", "\"\<\>\""}], "}"}], ",", "10", ",", "250",
      ",", "5", ",", " ", 
     RowBox[{"Appearance", "\[Rule]", " ", "\"\<Labeled\>\""}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Tiny"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Button", "[", 
    RowBox[{"\"\<reset n\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", " ", "=", " ", "10"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", "\[Rule]", "75"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "Delimiter", ",", "\[IndentingNewLine]", 
   "\"\<number of samples to draw (r)\>\"", ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "10", ",", "\"\<\>\""}], "}"}], ",", "10", ",", 
     "2000", ",", "5", ",", " ", 
     RowBox[{"Appearance", "\[Rule]", " ", "\"\<Labeled\>\""}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Tiny"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Button", "[", 
    RowBox[{"\"\<reset R\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", "10"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", "\[Rule]", "75"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sr", ",", "123"}], "}"}], ",", 
     RowBox[{"ControlType", "\[Rule]", "None"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AutorunSequencing", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"ControlPlacement", "\[Rule]", " ", "Left"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{
