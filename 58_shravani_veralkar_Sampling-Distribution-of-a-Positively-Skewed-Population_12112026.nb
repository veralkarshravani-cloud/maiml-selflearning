 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`n$$ = 10, $CellContext`r$$ = 
    10, $CellContext`sr$$ = 123, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
