      Manipulate`Dump`ThisIsNotAControl}, {{
       Hold[$CellContext`sr$$], 123}}}, Typeset`size$$ = {390., {223., 227.}},
     Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = 
    True, $CellContext`n$485938$$ = 0, $CellContext`r$485939$$ = 0}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`n$$ = 10, $CellContext`r$$ = 
        10, $CellContext`sr$$ = 123}, "ControllerVariables" :> {
        Hold[$CellContext`n$$, $CellContext`n$485938$$, 0], 
