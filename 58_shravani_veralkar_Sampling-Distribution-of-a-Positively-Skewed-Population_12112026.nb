           Histogram[
            Table[
             Mean[
              
              RandomChoice[$CellContext`pop$, $CellContext`n$$]], \
{$CellContext`r$$}], PlotLabel -> "The Sampling Distribution of the Mean"]}, 
          ImageSize -> {390, 450}]]), 
      "Specifications" :> {"generate a new population", 
