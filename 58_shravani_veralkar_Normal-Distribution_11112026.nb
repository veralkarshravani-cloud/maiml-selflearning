Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"m", ",", "s"}], "]"}], ",", "z"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{"m", "-", 
          RowBox[{"4", " ", "s"}]}], ",", 
         RowBox[{"m", "+", 
          RowBox[{"4", " ", "s"}]}]}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"PDF", "[", 
             RowBox[{
              RowBox[{"NormalDistribution", "[", 
               RowBox[{"0", ",", ".5"}], "]"}], ",", "0"}], "]"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"Frame", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"True", ",", "False", ",", "False", ",", "False"}], "}"}]}], 
       ",", 
       RowBox[{"Axes", "\[Rule]", "False"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", ".0075", "]"}], ",", 
          RowBox[{
           RowBox[{"ColorData", "[", "1", "]"}], "[", "1", "]"}]}], "}"}]}]}],
       "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "1"}], "]"}], ",", "z"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", ".0075", "]"}], ",", 
          RowBox[{
           RowBox[{"ColorData", "[", "1", "]"}], "[", "2", "]"}]}], "}"}]}]}],
       "]"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"500", ",", "300"}], "}"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", "\"\<mean \[Mu]\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", ".05", ",", 
     RowBox[{"Appearance", "\[Rule]", "\"\<Labeled\>\""}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "s", ",", "1", ",", " ", "\"\<standard deviation \[Sigma]\>\""}], "}"}],
      ",", ".5", ",", "2.", ",", ".05", ",", 
     RowBox[{"Appearance", "\[Rule]", "\"\<Labeled\>\""}]}], "}"}]}], 
  "]"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{
  3.35696210375764*^9, 3.4616349303653584`*^9, {3.4616677338037324`*^9, 
   3.4616677924917326`*^9}},
 CellID->788408435,ExpressionUUID->"cc0341be-a78c-48f1-9534-708a74219f97"],

