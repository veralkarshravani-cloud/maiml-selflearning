 CellID->138150581,ExpressionUUID->"336d4412-8993-413b-a2e1-264cee65c4d8"],

Cell[TextData[{
 "The probability density function for the normal distribution is given by\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "y", ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       RowBox[{"2", "\[Pi]", " ", 
        SuperscriptBox["\[Sigma]", "2"]}]]], 
     SuperscriptBox["e", 
      FractionBox[
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"y", "-", "\[Mu]"}], ")"}], "2"]}], 
       RowBox[{"2", 
        SuperscriptBox["\[Sigma]", "2"]}]]]}]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"dc918a6a-8672-4e09-a2f1-131305c00f8f"],
 ".\nThe red curve represents the standard normal density function with mean ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", "=", "0"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"71fdf1c1-7443-4258-bb10-1cd7035a8c62"],
 " and standard deviation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", "=", "1"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"b2338c88-16e5-4e5a-8e71-0a7a00e32ef4"],
 ". Use the sliders to see how normal density functions with other means and \
standard deviations compare to the standard normal density function."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{
  3.35696210375764*^9, {3.4616349451788197`*^9, 3.461634961115211*^9}, 
   3.461635657162446*^9, {3.4616678493087325`*^9, 3.4616678757527323`*^9}, {
   3.461694040640625*^9, 3.46169413125*^9}, 3.461928551448511*^9},
 CellID->190671489,ExpressionUUID->"bbed223c-cbea-4591-89cc-a582421048a0"]
}, Closed]],

