Cell[TextData[{
 "In this Demonstration, the test statistic is marked in red, the ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]], "InlineMath",ExpressionUUID->
  "4e5e7830-15a4-4c88-9ea8-59fd35b57941"],
 "-value is the purple area, the black line marks the boundary of the \
rejection region when the significance level is ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "00cd69be-5184-4f40-9107-8dc82a8564ed"],
 ", and the blue area is equal to ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "a93a1704-c0d6-4617-8b6a-a5d4fe427eea"],
 ". Samples are drawn from a uniformly distributed population with mean zero \
and variance controlled by the slider."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{
