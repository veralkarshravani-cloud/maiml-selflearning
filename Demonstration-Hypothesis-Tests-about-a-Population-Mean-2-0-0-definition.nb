Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"BlockRandom", "[", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "sr", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"3", "*", "sigma2"}], "]"}]}], ",", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"3", "*", "sigma2"}], "]"}]}], "}"}], ",", " ", "n"}], 
        "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"tstar", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Mean", "[", "data", "]"}], "-", "mu0"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"StandardDeviation", "[", "data", "]"}], "/", 
        RowBox[{"Sqrt", "[", "n", "]"}]}], ")"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"mark", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"test", "\[Equal]", "1"}], "||", 
        RowBox[{"test", "\[Equal]", "2"}]}], ",", 
       RowBox[{"Quantile", "[", 
        RowBox[{
         RowBox[{"StudentTDistribution", "[", 
          RowBox[{"n", "-", "1"}], "]"}], ",", 
         RowBox[{"1", "-", "alpha"}]}], "]"}], ",", " ", 
       RowBox[{"Quantile", "[", 
        RowBox[{
         RowBox[{"StudentTDistribution", "[", 
          RowBox[{"n", "-", "1"}], "]"}], ",", 
         RowBox[{"1", "-", 
          RowBox[{"alpha", "/", "2"}]}]}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"pvalue", "=", 
     RowBox[{"Switch", "[", 
      RowBox[{"test", ",", "1", ",", 
       RowBox[{"1", "-", 
        RowBox[{"CDF", "[", 
         RowBox[{
          RowBox[{"StudentTDistribution", "[", 
           RowBox[{"n", "-", "1"}], "]"}], ",", "tstar"}], "]"}]}], ",", "2", 
       ",", 
       RowBox[{"CDF", "[", 
        RowBox[{
         RowBox[{"StudentTDistribution", "[", 
          RowBox[{"n", "-", "1"}], "]"}], ",", "tstar"}], "]"}], ",", " ", 
       "3", ",", " ", 
       RowBox[{"2", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"CDF", "[", 
           RowBox[{
            RowBox[{"StudentTDistribution", "[", 
             RowBox[{"n", "-", "1"}], "]"}], ",", 
            RowBox[{"Abs", "[", "tstar", "]"}]}], "]"}]}], ")"}]}]}], "]"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PDF", "[", 
         RowBox[{
          RowBox[{"StudentTDistribution", "[", 
           RowBox[{"n", "-", "1"}], "]"}], ",", " ", "x"}], "]"}], ",", " ", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PDF", "[", 
          RowBox[{
           RowBox[{"StudentTDistribution", "[", 
            RowBox[{"n", "-", "1"}], "]"}], ",", " ", "x"}], "]"}], "*", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"Switch", "[", 
            RowBox[{"test", ",", "1", ",", 
             RowBox[{"x", "\[GreaterEqual]", "mark"}], ",", "2", ",", 
             RowBox[{"x", "\[LessEqual]", 
              RowBox[{"-", "mark"}]}], ",", "3", ",", 
             RowBox[{
              RowBox[{"Abs", "[", "x", "]"}], "\[GreaterEqual]", "mark"}]}], 
            "]"}], ",", "1", ",", "0"}], "]"}]}], ",", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"PDF", "[", 
          RowBox[{
           RowBox[{"StudentTDistribution", "[", 
            RowBox[{"n", "-", "1"}], "]"}], ",", " ", "x"}], "]"}], "*", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"Switch", "[", 
            RowBox[{"test", ",", "1", ",", 
             RowBox[{"x", "\[GreaterEqual]", "tstar"}], ",", "2", ",", 
             RowBox[{"x", "\[LessEqual]", "tstar"}], ",", "3", ",", 
             RowBox[{
              RowBox[{"Abs", "[", "x", "]"}], "\[GreaterEqual]", 
              RowBox[{"Abs", "[", "tstar", "]"}]}]}], "]"}], ",", "1", ",", 
           "0"}], "]"}]}]}], "}"}], ",", " ", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Filling", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"Axis", ",", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"ColorData", "[", 
                RowBox[{"1", ",", "1"}], "]"}], ",", 
               RowBox[{"Opacity", "[", ".5", "]"}]}], "]"}]}], "}"}]}], "}"}],
          " ", ",", 
         RowBox[{"{", 
          RowBox[{"3", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"Axis", ",", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"ColorData", "[", 
                RowBox[{"1", ",", "2"}], "]"}], ",", 
               RowBox[{"Opacity", "[", ".5", "]"}]}], "]"}]}], "}"}]}], 
          "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"Epilog", "\[Rule]", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"Black", ",", "Thick", ",", "\[IndentingNewLine]", 
         RowBox[{"Switch", "[", 
          RowBox[{"test", ",", "1", ",", "\[IndentingNewLine]", 
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"mark", ",", " ", 
                RowBox[{"-", ".02"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"mark", ",", 
                RowBox[{
                 RowBox[{"PDF", "[", 
                  RowBox[{
                   RowBox[{"StudentTDistribution", "[", 
                    RowBox[{"n", "-", "1"}], "]"}], ",", "mark"}], "]"}], "*",
                  "1.1"}]}], "}"}]}], "}"}], "]"}], ",", " ", "3", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"mark", ",", " ", 
                  RowBox[{"-", ".02"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"mark", ",", 
                  RowBox[{
                   RowBox[{"PDF", "[", 
                    RowBox[{
                    RowBox[{"StudentTDistribution", "[", 
                    RowBox[{"n", "-", "1"}], "]"}], ",", "mark"}], "]"}], "*",
                    "1.1"}]}], "}"}]}], "}"}], "]"}], " ", ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "mark"}], ",", " ", 
                  RowBox[{"-", ".02"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "mark"}], ",", 
                  RowBox[{
                   RowBox[{"PDF", "[", 
                    RowBox[{
                    RowBox[{"StudentTDistribution", "[", 
                    RowBox[{"n", "-", "1"}], "]"}], ",", 
                    RowBox[{"-", "mark"}]}], "]"}], "*", "1.1"}]}], "}"}]}], 
               "}"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", "2", ",", 
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "mark"}], ",", " ", 
                RowBox[{"-", ".02"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "mark"}], ",", 
                RowBox[{
                 RowBox[{"PDF", "[", 
                  RowBox[{
                   RowBox[{"StudentTDistribution", "[", 
                    RowBox[{"n", "-", "1"}], "]"}], ",", 
                   RowBox[{"-", "mark"}]}], "]"}], "*", "1.1"}]}], "}"}]}], 
             "}"}], "]"}]}], "]"}], " ", ",", "\[IndentingNewLine]", "Red", 
         ",", " ", "Thick", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"tstar", ",", " ", 
              RowBox[{"-", ".02"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"tstar", ",", 
              RowBox[{
               RowBox[{"PDF", "[", 
                RowBox[{
                 RowBox[{"StudentTDistribution", "[", 
                  RowBox[{"n", "-", "1"}], "]"}], ",", "tstar"}], "]"}], "*", 
               "1.1"}]}], "}"}]}], "}"}], "]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"400", ",", "400"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotLabel", "\[Rule]", "\[IndentingNewLine]", 
       RowBox[{"Grid", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", " ", "Red"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
            RowBox[{"\"\<test statistic: \>\"", ",", " ", "tstar"}], "}"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", " ", "Black"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
            RowBox[{"\"\<cutoff: \>\"", ",", " ", "mark"}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"\"\<conclusion: \>\"", ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"pvalue", "\[LessEqual]", "alpha"}], ",", " ", 
              "\"\<reject \!\(\*SubscriptBox[\(H\), \(0\)]\)\>\"", ",", " ", 
              "\"\<do not reject \!\(\*SubscriptBox[\(H\), \(0\)]\)\>\""}], 
             "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"p", ",", "\"\<\[Hyphen]value:\>\""}], "}"}], "]"}], 
            ",", "pvalue"}], "}"}]}], "}"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ColorData", "[", 
          RowBox[{"1", ",", "1"}], "]"}], ",", " ", "None", ",", "None"}], 
        "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", ".05"}], ",", ".45"}], "}"}]}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"test", ",", " ", "1", ",", " ", "\"\<test\>\""}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "\[Rule]", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
          "\"\<\!\(\*SubscriptBox[\(H\), \(a\)]\): \[Mu] \[GreaterEqual] \!\(\
\*SubscriptBox[\(\[Mu]\), \(0\)]\)\>\"", ",", " ", 
           "\"\<\!\(\*SubscriptBox[\(H\), \(0\)]\): \[Mu] = \
\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)\>\""}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"2", "\[Rule]", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
          "\"\<\!\(\*SubscriptBox[\(H\), \(a\)]\): \[Mu] \[LessEqual] \
\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)\>\"", ",", " ", 
           "\"\<\!\(\*SubscriptBox[\(H\), \(0\)]\): \[Mu] = \
\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)\>\""}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"3", "\[Rule]", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
          "\"\<\!\(\*SubscriptBox[\(H\), \(a\)]\): \[Mu] \[NotEqual] \
\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)\>\"", ",", " ", 
           "\"\<\!\(\*SubscriptBox[\(H\), \(0\)]\): \[Mu] = \
\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)\>\""}], "}"}], "]"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{"ControlPlacement", "\[Rule]", "Left"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "10"}], "}"}], ",", "2", ",", "50", ",", "1", ",", 
     RowBox[{"ImageSize", "\[Rule]", "Small"}], ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}], ",", 
     RowBox[{"ControlPlacement", "\[Rule]", "Left"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mu0", ",", 
       RowBox[{"-", "2"}], ",", " ", 
       "\"\<\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", 
     RowBox[{"ImageSize", "\[Rule]", "Small"}], ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}], ",", 
     RowBox[{"ControlPlacement", "\[Rule]", "Left"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"alpha", ",", ".05", ",", " ", "\"\<\[Alpha]\>\""}], "}"}], ",",
      ".01", ",", ".2", ",", 
     RowBox[{"ImageSize", "\[Rule]", "Small"}], ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}], ",", 
     RowBox[{"ControlPlacement", "\[Rule]", "Left"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sigma2", ",", " ", "33.3", ",", " ", 
       "\"\<\!\(\*SuperscriptBox[\(\[Sigma]\), \(2\)]\)\>\""}], "}"}], ",", 
     "5", ",", "50", ",", 
     RowBox[{"ImageSize", "\[Rule]", "Small"}], ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}], ",", 
     RowBox[{"ControlPlacement", "\[Rule]", "Left"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sr", ",", " ", "123", ",", " ", "\"\<seed\>\""}], "}"}], ",", 
     " ", "1", ",", "12345", ",", "1", ",", 
     RowBox[{"ImageSize", "\[Rule]", "Small"}], ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}], ",", 
     RowBox[{"ControlPlacement", "\[Rule]", "Left"}]}], "}"}], ",", 
   RowBox[{"TrackedSymbols", "\[Rule]", "Manipulate"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
