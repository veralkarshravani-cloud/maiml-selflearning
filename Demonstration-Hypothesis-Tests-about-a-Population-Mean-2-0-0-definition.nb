Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`alpha$$ = 
    0.05, $CellContext`mu0$$ = -2, $CellContext`n$$ = 
    10, $CellContext`sigma2$$ = 33.3, $CellContext`sr$$ = 
    123, $CellContext`test$$ = 1, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`test$$], 1, "test"}, {
      1 -> Column[{
         "\!\(\*SubscriptBox[\(H\), \(a\)]\): \[Mu] \[GreaterEqual] \
\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)", 
          "\!\(\*SubscriptBox[\(H\), \(0\)]\): \[Mu] = \!\(\*SubscriptBox[\(\
\[Mu]\), \(0\)]\)"}], 2 -> 
       Column[{"\!\(\*SubscriptBox[\(H\), \(a\)]\): \[Mu] \[LessEqual] \
\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)", 
          "\!\(\*SubscriptBox[\(H\), \(0\)]\): \[Mu] = \!\(\*SubscriptBox[\(\
\[Mu]\), \(0\)]\)"}], 3 -> 
       Column[{"\!\(\*SubscriptBox[\(H\), \(a\)]\): \[Mu] \[NotEqual] \
\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)", 
          "\!\(\*SubscriptBox[\(H\), \(0\)]\): \[Mu] = \!\(\*SubscriptBox[\(\
\[Mu]\), \(0\)]\)"}]}}, {{
       Hold[$CellContext`n$$], 10}, 2, 50, 1}, {{
       Hold[$CellContext`mu0$$], -2, 
       "\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)"}, -3, 3}, {{
       Hold[$CellContext`alpha$$], 0.05, "\[Alpha]"}, 0.01, 0.2}, {{
       Hold[$CellContext`sigma2$$], 33.3, 
       "\!\(\*SuperscriptBox[\(\[Sigma]\), \(2\)]\)"}, 5, 50}, {{
       Hold[$CellContext`sr$$], 123, "seed"}, 1, 12345, 1}}, 
    Typeset`size$$ = {400., {198., 202.}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = 
    True, $CellContext`test$12636$$ = False, $CellContext`n$12637$$ = 
    0, $CellContext`mu0$12638$$ = 0, $CellContext`alpha$12639$$ = 
    0, $CellContext`sigma2$12640$$ = 0, $CellContext`sr$12641$$ = 0}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`alpha$$ = 
        0.05, $CellContext`mu0$$ = -2, $CellContext`n$$ = 
        10, $CellContext`sigma2$$ = 33.3, $CellContext`sr$$ = 
        123, $CellContext`test$$ = 1}, "ControllerVariables" :> {
        Hold[$CellContext`test$$, $CellContext`test$12636$$, False], 
        Hold[$CellContext`n$$, $CellContext`n$12637$$, 0], 
        Hold[$CellContext`mu0$$, $CellContext`mu0$12638$$, 0], 
        Hold[$CellContext`alpha$$, $CellContext`alpha$12639$$, 0], 
        Hold[$CellContext`sigma2$$, $CellContext`sigma2$12640$$, 0], 
        Hold[$CellContext`sr$$, $CellContext`sr$12641$$, 0]}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, 
      "Body" :> (
       BlockRandom[
        SeedRandom[$CellContext`sr$$]; $CellContext`data = 
          RandomReal[{-Sqrt[3 $CellContext`sigma2$$], 
             Sqrt[
             3 $CellContext`sigma2$$]}, $CellContext`n$$]]; \
$CellContext`tstar = (Mean[$CellContext`data] - $CellContext`mu0$$)/(
         StandardDeviation[$CellContext`data]/
         Sqrt[$CellContext`n$$]); $CellContext`mark = If[
          Or[$CellContext`test$$ == 1, $CellContext`test$$ == 2], 
          Quantile[
           StudentTDistribution[$CellContext`n$$ - 1], 
           1 - $CellContext`alpha$$], 
          Quantile[
           StudentTDistribution[$CellContext`n$$ - 1], 
           1 - $CellContext`alpha$$/2]]; $CellContext`pvalue = 
        Switch[$CellContext`test$$, 1, 1 - CDF[
           StudentTDistribution[$CellContext`n$$ - 1], $CellContext`tstar], 2, 
          CDF[
           StudentTDistribution[$CellContext`n$$ - 1], $CellContext`tstar], 3,
           2 (1 - CDF[
            StudentTDistribution[$CellContext`n$$ - 1], 
            Abs[$CellContext`tstar]])]; Plot[{
          PDF[
           StudentTDistribution[$CellContext`n$$ - 1], $CellContext`x], PDF[
            StudentTDistribution[$CellContext`n$$ - 1], $CellContext`x] If[
            
            Switch[$CellContext`test$$, 
             1, $CellContext`x >= $CellContext`mark, 
             2, $CellContext`x <= -$CellContext`mark, 3, 
             Abs[$CellContext`x] >= $CellContext`mark], 1, 0], PDF[
            StudentTDistribution[$CellContext`n$$ - 1], $CellContext`x] If[
            
            Switch[$CellContext`test$$, 
             1, $CellContext`x >= $CellContext`tstar, 
             2, $CellContext`x <= $CellContext`tstar, 3, Abs[$CellContext`x] >= 
             Abs[$CellContext`tstar]], 1, 0]}, {$CellContext`x, -5, 5}, 
         Filling -> {{2 -> {Axis, 
              Directive[
               ColorData[1, 1], 
               Opacity[0.5]]}}, {3 -> {Axis, 
              Directive[
               ColorData[1, 2], 
               Opacity[0.5]]}}}, Epilog -> {Black, Thick, 
           Switch[$CellContext`test$$, 1, 
            Line[{{$CellContext`mark, -0.02}, {$CellContext`mark, PDF[
                 
                 StudentTDistribution[$CellContext`n$$ - 
                  1], $CellContext`mark] 1.1}}], 3, {
             Line[{{$CellContext`mark, -0.02}, {$CellContext`mark, PDF[
                  
                  StudentTDistribution[$CellContext`n$$ - 
                   1], $CellContext`mark] 1.1}}], 
             Line[{{-$CellContext`mark, -0.02}, {-$CellContext`mark, PDF[
                  
                  StudentTDistribution[$CellContext`n$$ - 
                   1], -$CellContext`mark] 1.1}}]}, 2, 
            Line[{{-$CellContext`mark, -0.02}, {-$CellContext`mark, PDF[
                 
                 StudentTDistribution[$CellContext`n$$ - 
                  1], -$CellContext`mark] 1.1}}]], Red, Thick, 
           Line[{{$CellContext`tstar, -0.02}, {$CellContext`tstar, PDF[
                
                StudentTDistribution[$CellContext`n$$ - 
                 1], $CellContext`tstar] 1.1}}]}, ImageSize -> {400, 400}, 
         PlotLabel -> Grid[{
            Map[Style[#, Red]& , {"test statistic: ", $CellContext`tstar}], 
            Map[Style[#, Black]& , {"cutoff: ", $CellContext`mark}], {
            "conclusion: ", 
             
             If[$CellContext`pvalue <= $CellContext`alpha$$, 
              "reject \!\(\*SubscriptBox[\(H\), \(0\)]\)", 
              "do not reject \!\(\*SubscriptBox[\(H\), \(0\)]\)"]}, {
             Row[{$CellContext`p, "\[Hyphen]value:"}], $CellContext`pvalue}}],
          PlotStyle -> {
           ColorData[1, 1], None, None}, PlotRange -> {-0.05, 0.45}]), 
      "Specifications" :> {{{$CellContext`test$$, 1, "test"}, {
         1 -> Column[{
            "\!\(\*SubscriptBox[\(H\), \(a\)]\): \[Mu] \[GreaterEqual] \
\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)", 
             "\!\(\*SubscriptBox[\(H\), \(0\)]\): \[Mu] = \!\(\*SubscriptBox[\
\(\[Mu]\), \(0\)]\)"}], 2 -> 
          Column[{"\!\(\*SubscriptBox[\(H\), \(a\)]\): \[Mu] \[LessEqual] \
\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)", 
             "\!\(\*SubscriptBox[\(H\), \(0\)]\): \[Mu] = \!\(\*SubscriptBox[\
\(\[Mu]\), \(0\)]\)"}], 3 -> 
          Column[{"\!\(\*SubscriptBox[\(H\), \(a\)]\): \[Mu] \[NotEqual] \!\(\
\*SubscriptBox[\(\[Mu]\), \(0\)]\)", 
             "\!\(\*SubscriptBox[\(H\), \(0\)]\): \[Mu] = \!\(\*SubscriptBox[\
\(\[Mu]\), \(0\)]\)"}]}, ControlPlacement -> Left}, {{$CellContext`n$$, 10}, 
         2, 50, 1, ImageSize -> Small, Appearance -> "Labeled", 
         ControlPlacement -> 
         Left}, {{$CellContext`mu0$$, -2, 
          "\!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\)"}, -3, 3, ImageSize -> 
         Small, Appearance -> "Labeled", ControlPlacement -> 
         Left}, {{$CellContext`alpha$$, 0.05, "\[Alpha]"}, 0.01, 0.2, 
         ImageSize -> Small, Appearance -> "Labeled", ControlPlacement -> 
         Left}, {{$CellContext`sigma2$$, 33.3, 
          "\!\(\*SuperscriptBox[\(\[Sigma]\), \(2\)]\)"}, 5, 50, ImageSize -> 
         Small, Appearance -> "Labeled", ControlPlacement -> 
         Left}, {{$CellContext`sr$$, 123, "seed"}, 1, 12345, 1, ImageSize -> 
         Small, Appearance -> "Labeled", ControlPlacement -> Left}}, 
      "Options" :> {TrackedSymbols -> Manipulate}, 
      "DefaultOptions" :> {ControllerLinking -> True}],
     ImageSizeCache->{
      650.3665234375001, {224.90445861816409`, 230.63639221191409`}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
