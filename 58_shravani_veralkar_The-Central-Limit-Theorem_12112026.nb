 CellID->138150581,ExpressionUUID->"daa0851f-19fe-4b09-b196-7de2bbb73d41"],

Cell["\<\
The central limit theorem states that the sampling distribution of the sample \
mean approaches a normal distribution as the size of the sample grows. This \
means that the histogram of the means of many samples should approach a \
bell-shaped curve. Each sample consists of 200 pseudorandom numbers between 0 \
and 100, inclusive.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{3.35696210375764*^9, 3.505599788377243*^9},
 CellID->190671489,ExpressionUUID->"f414d6b1-d974-45ff-a6b6-00386160620d"]
}, Closed]],

