Cell[CellGroupData[{
Cell["3x3 Matrix Explorer", "Title",ExpressionUUID->"f4a69adb-d35e-4a4f-96a6-6003ea0575b0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"degenvec", "[", "vec_", "]"}], ":=", 
   RowBox[{"Delete", "[", 
    RowBox[{"vec", ",", 
     RowBox[{"Position", "[", 
      RowBox[{"vec", ",", "0"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"degenmat", "[", "mat_", "]"}], ":=", 
   RowBox[{"Complement", "[", 
    RowBox[{"mat", ",", 
     RowBox[{"Select", "[", 
      RowBox[{"mat", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", "#", "]"}], "<", ".1"}], "&"}]}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"matrixstyle", "[", "mat_", "]"}], ":=", 
   RowBox[{"Text", "[", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{"MatrixForm", "[", 
           RowBox[{"mat", ",", " ", 
            RowBox[{"TableSpacing", "\[Rule]", "1.5"}], ",", " ", 
            RowBox[{"TableAlignments", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"Center", ",", " ", "Center"}], "}"}]}]}], "]"}], ",", 
          ".01"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "]"}], ",", "12"}], "]"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"labelstyle", "[", "x_", "]"}], ":=", 
   RowBox[{"Text", "@", 
    RowBox[{"Style", "[", 
     RowBox[{"x", ",", "Bold", ",", "Underlined", ",", "14"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"style1", "[", "x_", "]"}], ":=", 
   RowBox[{"Text", "@", 
    RowBox[{"Style", "[", 
     RowBox[{"x", ",", "12"}], "]"}]}]}], ";"}]}], "Input",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000},ExpressionUUID->"3581cfcc-9a13-4dce-a4d1-13da1df253f9"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{"intQ", ",", 
         RowBox[{"Round", "[", "#", "]"}], ",", "#"}], "]"}], "&"}], "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a11", ",", "a12", ",", "a13"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"a21", ",", "a22", ",", "a23"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"a31", ",", "a32", ",", "a33"}], "}"}]}], "}"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Pane", "[", 
     RowBox[{
      RowBox[{"Column", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Grid", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"labelstyle", "[", "\"\<Matrix\>\"", "]"}], ",", 
               RowBox[{"labelstyle", "[", "\"\<Transpose\>\"", "]"}], ",", 
               RowBox[{"labelstyle", "[", "\"\<Inverse\>\"", "]"}]}], "}"}], 
             ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{"intQ", ",", " ", 
                 RowBox[{"Text", "[", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"MatrixForm", "[", 
                    RowBox[{"a", ",", 
                    RowBox[{"TableSpacing", "\[Rule]", "1.5"}], ",", " ", 
                    RowBox[{"TableAlignments", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"Center", ",", " ", "Center"}], "}"}]}]}], "]"}], 
                    ",", "12"}], "]"}], "]"}], ",", 
                 RowBox[{"matrixstyle", "[", "a", "]"}]}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{"intQ", ",", 
                 RowBox[{"Text", "[", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"MatrixForm", "[", 
                    RowBox[{
                    RowBox[{"Transpose", "[", "a", "]"}], ",", " ", 
                    RowBox[{"TableSpacing", "\[Rule]", "1.5"}], ",", " ", 
                    RowBox[{"TableAlignments", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"Center", ",", " ", "Center"}], "}"}]}]}], "]"}], 
                    ",", "12"}], "]"}], "]"}], ",", 
                 RowBox[{"matrixstyle", "[", 
                  RowBox[{"Transpose", "[", "a", "]"}], "]"}]}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"Det", "[", "a", "]"}], "]"}], ">", ".0001"}], ",", 
                 RowBox[{"matrixstyle", "[", 
                  RowBox[{"Inverse", "[", 
                   RowBox[{"N", "[", "a", "]"}], "]"}], "]"}], ",", " ", 
                 RowBox[{"style1", "[", "\"\<Not invertible\>\"", "]"}]}], 
                "]"}]}], "\[IndentingNewLine]", "}"}]}], "}"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Grid", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"labelstyle", "[", "\"\<Trace\>\"", "]"}], ",", " ", 
               RowBox[{"labelstyle", "[", "\"\<Determinant\>\"", "]"}], ",", 
               " ", 
               RowBox[{"labelstyle", "[", "\"\<Rank\>\"", "]"}]}], "}"}], ",",
              "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"style1", "@", 
                RowBox[{"Tr", "[", "a", "]"}]}], ",", " ", 
               RowBox[{"style1", "@", 
                RowBox[{"Det", "[", "a", "]"}]}], ",", " ", 
               RowBox[{"style1", "@", 
                RowBox[{"MatrixRank", "[", "a", "]"}]}]}], "}"}]}], "}"}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Grid", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"labelstyle", "[", "\"\<Eigenvalues\>\"", "]"}], ",", 
               " ", 
               RowBox[{"labelstyle", "[", "\"\<Eigenvectors\>\"", "]"}]}], 
              "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"matrixstyle", "[", 
                RowBox[{"degenvec", "@", 
                 RowBox[{"Eigenvalues", "[", 
                  RowBox[{"N", "@", "a"}], "]"}]}], "]"}], ",", 
               RowBox[{"matrixstyle", "[", 
                RowBox[{"degenmat", "@", 
                 RowBox[{"Eigenvectors", "[", 
                  RowBox[{"N", "[", "a", "]"}], "]"}]}], "]"}]}], "}"}]}], 
            "}"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", " ", 
        RowBox[{"Alignment", "\[Rule]", "Center"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"380", ",", "250"}], "}"}], ",", 
      RowBox[{"Alignment", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Center", ",", "Top"}], "}"}]}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a11", ",", "1", ",", "\"\<(1,1)\>\""}], "}"}], ",", " ", 
     RowBox[{"-", "5"}], ",", "5", ",", 
     RowBox[{"ImageSize", "\[Rule]", "Tiny"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
