Cell[TextData[{
 "The transpose of a matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "InlineMath",ExpressionUUID->
  "24c1f854-645c-4bdd-8596-5dd3b92fc5d0"],
 " is a matrix ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "T"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "6fb9bec5-80fe-41ac-9a79-89ae2cb3fa77"],
 " whose ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "8eee70a4-7efe-4ff2-9165-a171f18719f9"],
 " column is equal to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "d2c7219b-0561-4a88-ae24-b7205e634375"],
 " row of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "InlineMath",ExpressionUUID->
  "b7fc880d-ec62-4333-bf0c-89f0ec7228bc"],
 "."
}], "Text",
 TaggingRules->{},
 CellID->190671489,ExpressionUUID->"2b405b15-a825-4b53-9375-9601f8568b4b"],

Cell[TextData[{
 "The inverse of a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"7542f97c-5e37-4d6b-b1aa-4a716511d93a"],
 " matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "InlineMath",ExpressionUUID->
  "63be7c0b-e99e-4454-ae02-770b28ac6679"],
 " is a matrix ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"-", "1"}]], TraditionalForm]], "InlineMath",ExpressionUUID->
  "4356b4c8-8d81-4347-876e-88519eae01cf"],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " ", 
    SuperscriptBox["A", 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "3159370c-43b6-411f-8e82-41366dcc3646"],
 " is the identity matrix."
}], "Text",
 TaggingRules->{},
 CellID->134234346,ExpressionUUID->"148d43bf-9d66-4378-82ad-7ef1047bdc6d"],

Cell["\<\
The trace of a matrix is the sum of the entries on the main diagonal \
(upper-left to lower-right).\
\>", "Text",
 TaggingRules->{},
 CellID->15337696,ExpressionUUID->"3dae2412-e705-4333-92fc-3e6a8702875b"],

Cell[TextData[{
 "The determinant is computed from all the entries of the matrix and is \
nonzero precisely when the matrix is nonsingular, that is, when the equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", "x"}], "=", "b"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"35c447e6-14a9-4941-bc4a-72a4beb50f5b"],
 " always has a unique solution."
}], "Text",
 TaggingRules->{},
 CellID->492006551,ExpressionUUID->"3648a3ef-97b0-4e81-ad0a-9c8147044f51"],

Cell["\<\
The matrix rank is the number of linearly independent columns and is equal to \
three precisely when the matrix is nonsingular.\
\>", "Text",
 TaggingRules->{},
 CellID->104763668,ExpressionUUID->"01af207d-0e25-45f9-aee2-aa59cf912996"],

Cell[TextData[{
 "A number ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "55091c3a-332b-4c6d-baeb-010260bfc89e"],
 " is an eigenvalue of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "InlineMath",ExpressionUUID->
  "7c51e2bb-2ae5-464e-b400-ee150df715ee"],
 " if there is some nonzero vector ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineMath",ExpressionUUID->
  "4e945c60-554c-4091-9afb-872400c07091"],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", "x"}], "=", 
    RowBox[{"\[Lambda]", " ", "x"}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"bddc96d9-b0a6-4e6d-be65-ca1001e1084a"],
 "; the vector ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineMath",ExpressionUUID->
  "3c2e75d7-b9fa-469f-8907-a13dc12a1d46"],
 " is called an eigenvector. In the result, the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "4ca8fb0d-77d9-4214-b32d-1ff6576736d0"],
 " row of the eigenvector array is an eigenvector of unit length associated \
with the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "cce98b51-48eb-49b6-a83e-45c24213a663"],
 " eigenvalue in the eigenvalue array."
}], "Text",
